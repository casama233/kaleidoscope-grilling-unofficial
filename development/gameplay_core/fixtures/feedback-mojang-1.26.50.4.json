  "files": [
    {
      "path": "resource_pack/particles/basic_crit.json",
      "url": "https://raw.githubusercontent.com/Mojang/bedrock-samples/v1.26.50.4/resource_pack/particles/basic_crit.json",
      "sha256": "a141a0ae4396a9cb81d0471728b45f08d7371c2e1fc7bbe7c4173bef245791ac",
      "text": "{\n  \"format_version\": \"1.26.10\",\n  \"particle_effect\": {\n    \"description\": {\n      \"identifier\": \"minecraft:basic_crit_particle\",\n      \"basic_render_parameters\": {\n        \"material\": \"particles_alpha\",\n        \"texture\": \"textures/particle/particles\"\n      }\n    },\n    \"components\": {\n      \"minecraft:emitter_lifetime_once\": {\n        \"active_time\": 0.15\n      },\n      \"minecraft:emitter_rate_instant\": {\n        \"num_particles\": 1\n      },\n      \"minecraft:emitter_shape_point\": {\n        \"direction\": [\n          \"variable.direction.x\",\n          \"variable.direction.y\",\n          \"variable.direction.z\"\n        ]\n      },\n      \"minecraft:particle_appearance_billboard\": {\n        \"size\": [\n          \"0.10 + variable.particle_random_1*0.05\",\n          \"0.10 + variable.particle_random_1*0.05\"\n        ],\n        \"facing_camera_mode\": \"lookat_xyz\",\n        \"direction\": {\n          \"mode\": \"derive_from_velocity\",\n          \"custom_direction\": [\n            0,\n            0,\n            0\n          ],\n          \"min_speed_threshold\": 0.1\n        },\n        \"uv\": {\n          \"texture_width\": 128,\n          \"texture_height\": 128,\n          \"uv\": [\n            0,\n            0\n          ],\n          \"uv_size\": [\n            1,\n            1\n          ],\n          \"flipbook\": {\n            \"base_UV\": [\n              0,\n              72\n            ],\n            \"size_UV\": [\n              8,\n              8\n            ],\n            \"step_UV\": [\n              8,\n              0\n            ],\n            \"frames_per_second\": 8,\n            \"max_frame\": 8,\n            \"stretch_to_lifetime\": true\n          }\n        }\n      },\n      \"minecraft:particle_appearance_lighting\": {},\n      \"minecraft:particle_appearance_tinting\": {\n        \"color\": {\n          \"gradient\": {\n            \"0.000000\": [\n              \"variable.particle_random_1*0.3 + 0.6\",\n              \"variable.particle_random_2*0.3+ 0.6\",\n              \"variable.particle_random_2*0.3+ 0.6\",\n              1\n            ],\n            \"1.000000\": [\n              \"variable.particle_random_1*0.3 + 0.6\",\n              0.5,\n              0.3,\n              1\n            ]\n          },\n          \"interpolant\": \"variable.particle_age/variable.particle_lifetime\"\n        }\n      },\n      \"minecraft:particle_initial_speed\": 2,\n      \"minecraft:particle_lifetime_expression\": {\n        \"max_lifetime\": \"6.0 / (Math.random(0.0, 16.0) + 12.0)\"\n      },\n      \"minecraft:particle_motion_dynamic\": {\n        \"linear_acceleration\": [\n          0,\n          -10,\n          0\n        ],\n        \"linear_drag_coefficient\": 10\n      }\n    }\n  }\n}"
    },
    {
      "path": "resource_pack/particles/electric_spark.json",
      "url": "https://raw.githubusercontent.com/Mojang/bedrock-samples/v1.26.50.4/resource_pack/particles/electric_spark.json",
      "sha256": "0fa201a359bf3d4dcee9e1746c9ff073a0669b029857151710d7116504ecfd28",
      "text": "{\n  \"format_version\": \"1.26.10\",\n  \"particle_effect\": {\n    \"description\": {\n      \"identifier\": \"minecraft:electric_spark_particle\",\n      \"basic_render_parameters\": {\n        \"material\": \"particles_alpha\",\n        \"texture\": \"textures/particle/particles\"\n      }\n    },\n    \"components\": {\n      \"minecraft:emitter_initialization\": {\n        \"creation_expression\": \"variable.size = Math.random(0.1, 0.2);\"\n      },\n      \"minecraft:emitter_lifetime_once\": {},\n      \"minecraft:emitter_rate_instant\": {\n        \"num_particles\": 1\n      },\n      \"minecraft:emitter_shape_point\": {\n        \"direction\": [\n          \"(variable.particle_random_1 * variable.direction.x) - (variable.direction.x / 2.0)\",\n          \"(variable.particle_random_2 * variable.direction.y) - (variable.direction.y / 2.0)\",\n          \"(variable.particle_random_3 * variable.direction.z) - (variable.direction.z / 2.0)\"\n        ]\n      },\n      \"minecraft:particle_appearance_billboard\": {\n        \"size\": [\n          \"variable.size\",\n          \"variable.size\"\n        ],\n        \"facing_camera_mode\": \"lookat_xyz\",\n        \"direction\": {\n          \"mode\": \"derive_from_velocity\",\n          \"custom_direction\": [\n            0,\n            0,\n            0\n          ],\n          \"min_speed_threshold\": 0.1\n        },\n        \"uv\": {\n          \"texture_width\": 128,\n          \"texture_height\": 128,\n          \"uv\": [\n            16,\n            48\n          ],\n          \"uv_size\": [\n            8,\n            8\n          ]\n        }\n      },\n      \"minecraft:particle_appearance_tinting\": {\n        \"color\": {\n          \"gradient\": {\n            \"0.000000\": [\n              1,\n              0.9,\n              1,\n              1\n            ]\n          },\n          \"interpolant\": 0\n        }\n      },\n      \"minecraft:particle_initial_speed\": -1,\n      \"minecraft:particle_lifetime_expression\": {\n        \"max_lifetime\": \"((variable.particle_random_1 * 2) + 3) / 20\"\n      },\n      \"minecraft:particle_motion_dynamic\": {\n        \"linear_drag_coefficient\": 0.96\n      }\n    }\n  }\n}"
    },
    {
      "path": "resource_pack/particles/villager_happy.json",
      "url": "https://raw.githubusercontent.com/Mojang/bedrock-samples/v1.26.50.4/resource_pack/particles/villager_happy.json",
      "sha256": "4bc5944a7e7be7cf2363b5c6df0954416bdbc9c28aee984cde3f143cc5ac8257",
      "text": "{\n  \"format_version\": \"1.26.10\",\n  \"particle_effect\": {\n    \"description\": {\n      \"identifier\": \"minecraft:villager_happy\",\n      \"basic_render_parameters\": {\n        \"material\": \"particles_alpha\",\n        \"texture\": \"textures/particle/particles\"\n      }\n    },\n    \"components\": {\n      \"minecraft:emitter_lifetime_expression\": {},\n      \"minecraft:emitter_rate_manual\": {\n        \"max_particles\": 25\n      },\n      \"minecraft:emitter_shape_point\": {\n        \"direction\": [\n          \"Math.random(0, 0.02)\",\n          \"Math.random(0, 0.02)\",\n          \"Math.random(0, 0.02)\"\n        ]\n      },\n      \"minecraft:particle_appearance_billboard\": {\n        \"size\": [\n          0.14,\n          0.14\n        ],\n        \"facing_camera_mode\": \"lookat_xyz\",\n        \"direction\": {\n          \"mode\": \"derive_from_velocity\",\n          \"custom_direction\": [\n            0,\n            0,\n            0\n          ],\n          \"min_speed_threshold\": 0.1\n        },\n        \"uv\": {\n          \"texture_width\": 128,\n          \"texture_height\": 128,\n          \"uv\": [\n            16,\n            40\n          ],\n          \"uv_size\": [\n            8,\n            8\n          ]\n        }\n      },\n      \"minecraft:particle_appearance_lighting\": {},\n      \"minecraft:particle_initial_speed\": 0,\n      \"minecraft:particle_lifetime_expression\": {\n        \"max_lifetime\": \"Math.random(1, 5)\"\n      },\n      \"minecraft:particle_motion_dynamic\": {\n        \"linear_acceleration\": [\n          \"Math.random(-0.02, 0.02)\",\n          \"Math.random(-0.02, 0.02)\",\n          \"Math.random(-0.02, 0.02)\"\n        ]\n      }\n    }\n  }\n}"
    },
    {
      "path": "resource_pack/particles/endrod.json",
      "url": "https://raw.githubusercontent.com/Mojang/bedrock-samples/v1.26.50.4/resource_pack/particles/endrod.json",
      "sha256": "4acd3d7f02b6f53fc81b92a628dee73004115ee389ff7fe7a5e59cd163cdb8b2",
      "text": "{\n  \"format_version\": \"1.26.10\",\n  \"particle_effect\": {\n    \"description\": {\n      \"identifier\": \"minecraft:endrod\",\n      \"basic_render_parameters\": {\n        \"material\": \"particles_blend\",\n        \"texture\": \"textures/particle/particles\"\n      }\n    },\n    \"components\": {\n      \"minecraft:emitter_lifetime_expression\": {},\n      \"minecraft:emitter_rate_manual\": {\n        \"max_particles\": 50\n      },\n      \"minecraft:emitter_shape_point\": {\n        \"direction\": [\n          0,\n          -1,\n          0\n        ]\n      },\n      \"minecraft:particle_appearance_billboard\": {\n        \"size\": [\n          \"(variable.particle_random_1 * 0.5f + 0.5f) * 0.2\",\n          \"(variable.particle_random_1 * 0.5f + 0.5f) * 0.2\"\n        ],\n        \"facing_camera_mode\": \"lookat_xyz\",\n        \"direction\": {\n          \"mode\": \"derive_from_velocity\",\n          \"custom_direction\": [\n            0,\n            0,\n            0\n          ],\n          \"min_speed_threshold\": 0.1\n        },\n        \"uv\": {\n          \"texture_width\": 128,\n          \"texture_height\": 128,\n          \"uv\": [\n            0,\n            0\n          ],\n          \"uv_size\": [\n            1,\n            1\n          ],\n          \"flipbook\": {\n            \"base_UV\": [\n              56,\n              88\n            ],\n            \"size_UV\": [\n              8,\n              8\n            ],\n            \"step_UV\": [\n              -8,\n              0\n            ],\n            \"frames_per_second\": 8,\n            \"max_frame\": 8,\n            \"stretch_to_lifetime\": true\n          }\n        }\n      },\n      \"minecraft:particle_appearance_tinting\": {\n        \"color\": {\n          \"gradient\": {\n            \"0.000000\": [\n              \"variable.particle_age > (variable.particle_lifetime / 2.0) ? 1 - (0.0153 * (1 - Math.pow(0.7, variable.particle_age)) / (1 - 0.7)) : 1.0\",\n              \"variable.particle_age > (variable.particle_lifetime / 2.0) ? 1 - (0.0387 * (1 - Math.pow(0.7, variable.particle_age)) / (1 - 0.7)) : 1.0\",\n              \"variable.particle_age > (variable.particle_lifetime / 2.0) ? 1 - (0.0636 * (1 - Math.pow(0.7, variable.particle_age)) / (1 - 0.7)) : 1.0\",\n              \"variable.particle_age > (variable.particle_lifetime / 2.0) ? 1 - 0.60 * ((variable.particle_age - (variable.particle_lifetime / 2.0)) / (variable.particle_lifetime / 2.0)) : 1.0\"\n            ]\n          },\n          \"interpolant\": 0\n        }\n      },\n      \"minecraft:particle_initial_speed\": 0,\n      \"minecraft:particle_lifetime_expression\": {\n        \"max_lifetime\": \"Math.random(3, 3.6)\"\n      },\n      \"minecraft:particle_motion_dynamic\": {\n        \"linear_acceleration\": [\n          0,\n          -0.2,\n          0\n        ],\n        \"linear_drag_coefficient\": 0.49\n      }\n    }\n  }\n}"
    },
    {
      "path": "resource_pack/particles/basic_smoke.json",
      "url": "https://raw.githubusercontent.com/Mojang/bedrock-samples/v1.26.50.4/resource_pack/particles/basic_smoke.json",
      "sha256": "4bf0682b980c0041892acffbb13c970fc4dc451f73a20498a87f2c98615504c4",
      "text": "{\n  \"format_version\": \"1.26.10\",\n  \"particle_effect\": {\n    \"description\": {\n      \"identifier\": \"minecraft:basic_smoke_particle\",\n      \"basic_render_parameters\": {\n        \"material\": \"particles_alpha\",\n        \"texture\": \"textures/particle/particles\"\n      }\n    },\n    \"components\": {\n      \"minecraft:emitter_lifetime_expression\": {},\n      \"minecraft:emitter_rate_manual\": {\n        \"max_particles\": 50\n      },\n      \"minecraft:emitter_shape_custom\": {\n        \"direction\": [\n          \"Math.random(-0.1, 0.1)\",\n          1,\n          \"Math.random(-0.1, 0.1)\"\n        ]\n      },\n      \"minecraft:particle_appearance_billboard\": {\n        \"size\": [\n          0.1,\n          0.1\n        ],\n        \"facing_camera_mode\": \"lookat_xyz\",\n        \"direction\": {\n          \"mode\": \"derive_from_velocity\",\n          \"custom_direction\": [\n            0,\n            0,\n            0\n          ],\n          \"min_speed_threshold\": 0.1\n        },\n        \"uv\": {\n          \"texture_width\": 128,\n          \"texture_height\": 128,\n          \"uv\": [\n            0,\n            0\n          ],\n          \"uv_size\": [\n            1,\n            1\n          ],\n          \"flipbook\": {\n            \"base_UV\": [\n              56,\n              0\n            ],\n            \"size_UV\": [\n              8,\n              8\n            ],\n            \"step_UV\": [\n              -8,\n              0\n            ],\n            \"frames_per_second\": 8,\n            \"max_frame\": 8,\n            \"stretch_to_lifetime\": true\n          }\n        }\n      },\n      \"minecraft:particle_appearance_lighting\": {},\n      \"minecraft:particle_appearance_tinting\": {\n        \"color\": {\n          \"gradient\": {\n            \"0.000000\": [\n              \"variable.particle_random_1*0.5\",\n              \"variable.particle_random_1*0.5\",\n              \"variable.particle_random_1*0.5\",\n              1\n            ]\n          },\n          \"interpolant\": 0\n        }\n      },\n      \"minecraft:particle_initial_speed\": 1,\n      \"minecraft:particle_lifetime_expression\": {\n        \"max_lifetime\": \"Math.random(0.4, 1.4)\"\n      },\n      \"minecraft:particle_motion_dynamic\": {\n        \"linear_acceleration\": [\n          0,\n          0.4,\n          0\n        ]\n      }\n    }\n  }\n}"
    },
    {
      "path": "resource_pack/particles/basic_flame.json",
      "url": "https://raw.githubusercontent.com/Mojang/bedrock-samples/v1.26.50.4/resource_pack/particles/basic_flame.json",
      "sha256": "3c1e31639c2b95b6147413c69e7fff19d0e9f2713fdbbd499b47af4cbaaf4fe1",
      "text": "{\n  \"format_version\": \"1.26.10\",\n  \"particle_effect\": {\n    \"description\": {\n      \"identifier\": \"minecraft:basic_flame_particle\",\n      \"basic_render_parameters\": {\n        \"material\": \"particles_alpha\",\n        \"texture\": \"textures/particle/particles\"\n      }\n    },\n    \"components\": {\n      \"minecraft:emitter_lifetime_expression\": {},\n      \"minecraft:emitter_rate_manual\": {\n        \"max_particles\": 100\n      },\n      \"minecraft:emitter_shape_sphere\": {\n        \"radius\": 0.025,\n        \"direction\": [\n          0,\n          0,\n          0\n        ]\n      },\n      \"minecraft:particle_appearance_billboard\": {\n        \"size\": [\n          \"(0.1 + variable.particle_random_1*0.1) - (0.1 * variable.particle_age)\",\n          \"(0.1 + variable.particle_random_1*0.1) - (0.1 * variable.particle_age)\"\n        ],\n        \"facing_camera_mode\": \"lookat_xyz\",\n        \"direction\": {\n          \"mode\": \"derive_from_velocity\",\n          \"custom_direction\": [\n            0,\n            0,\n            0\n          ],\n          \"min_speed_threshold\": 0.1\n        },\n        \"uv\": {\n          \"texture_width\": 128,\n          \"texture_height\": 128,\n          \"uv\": [\n            0,\n            24\n          ],\n          \"uv_size\": [\n            8,\n            8\n          ]\n        }\n      },\n      \"minecraft:particle_lifetime_expression\": {\n        \"max_lifetime\": \"Math.random(0.6, 2.0)\"\n      }\n    }\n  }\n}"
    }
