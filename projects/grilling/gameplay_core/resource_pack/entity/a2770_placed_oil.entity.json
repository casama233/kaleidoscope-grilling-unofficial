        "glow": "textures/a2770_placed/oil_pot_premium_glow"
      },
      "geometry": {
        "default": "geometry.kg_a2770.oil_skin",
        "glow": "geometry.kg_a2770.oil_glow"
      },
      "render_controllers": [
        {
          "controller.render.kg_a2770.oil": "q.property('kaleidoscope_grilling:ready') && q.property('kaleidoscope_grilling:oil') > 0"
        },
        {
          "controller.render.kg_a2770.oil_glow": "q.property('kaleidoscope_grilling:ready') && q.property('kaleidoscope_grilling:oil') == 3"
