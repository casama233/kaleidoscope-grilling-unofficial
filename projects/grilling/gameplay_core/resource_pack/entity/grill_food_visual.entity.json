      "scripts": {
        "initialize": [
          "v.previous_flips = -1;",
          "v.flip_started = -1;"
        ],
        "pre_animation": [
          "v.flip_started = q.property('kaleidoscope_grilling:flips') == 0 ? -1 : v.previous_flips >= 0 && v.previous_flips != q.property('kaleidoscope_grilling:flips') && q.property('kaleidoscope_grilling:flips') > 0 ? q.life_time : v.flip_started;",
          "v.previous_flips = q.property('kaleidoscope_grilling:flips');",
          "v.flip_progress = v.flip_started < 0 ? 1 : math.clamp((q.life_time-v.flip_started)/0.7,0,1);"
        ],
        "animate": [
          "flip"
        ]
      },
      "animations": {
        "flip": "animation.kg_station.grill_flip"
      },
