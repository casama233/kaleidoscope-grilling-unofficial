{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kaleidoscope_grilling:feedback_cloud",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/kg_java_smoke"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.kg_cloud_life/20"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.kg_cloud_size*math.clamp(variable.particle_age*20/variable.kg_cloud_life*32,0,1)",
          "variable.kg_cloud_size*math.clamp(variable.particle_age*20/variable.kg_cloud_life*32,0,1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 8,
          "uv": [
            "math.min(7,math.floor(variable.kg_cloud_age*7/variable.kg_cloud_life))*8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.kg_cloud_gray",
          "variable.kg_cloud_gray",
          "variable.kg_cloud_gray",
          1
        ]
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.kg_cloud_life=math.max(1,math.floor(math.floor(8/(math.random(0,1)*0.8+0.3))*2.5));variable.kg_cloud_size=(0.1+math.random(0,0.1))*1.875;"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": "kg_cloud_init"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.kg_cloud_age=math.floor(variable.particle_age*20);loop(math.max(0,math.min(variable.kg_cloud_age+1,variable.kg_cloud_life)-variable.kg_cloud_tick), {variable.kg_cloud_oldx=variable.kg_cloud_x;variable.kg_cloud_oldy=variable.kg_cloud_y;variable.kg_cloud_oldz=variable.kg_cloud_z;variable.kg_cloud_dy=variable.kg_cloud_dy-(0);variable.kg_cloud_x=variable.kg_cloud_x+(variable.kg_cloud_dx);variable.kg_cloud_dx=variable.kg_cloud_dx*(0.96);variable.kg_cloud_y=variable.kg_cloud_y+(variable.kg_cloud_dy);variable.kg_cloud_dy=variable.kg_cloud_dy*(0.96);variable.kg_cloud_z=variable.kg_cloud_z+(variable.kg_cloud_dz);variable.kg_cloud_dz=variable.kg_cloud_dz*(0.96);variable.kg_cloud_tick=variable.kg_cloud_tick+(1);});"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.kg_cloud_oldx+(variable.kg_cloud_x-variable.kg_cloud_oldx)*math.mod(variable.particle_age*20,1)",
          "variable.kg_cloud_oldy+(variable.kg_cloud_y-variable.kg_cloud_oldy)*math.mod(variable.particle_age*20,1)",
          "variable.kg_cloud_oldz+(variable.kg_cloud_z-variable.kg_cloud_oldz)*math.mod(variable.particle_age*20,1)"
        ]
      }
    },
    "events": {
      "kg_cloud_init": {
        "expression": "variable.kg_cloud_tick=0;variable.kg_cloud_age=0;variable.kg_cloud_x=0;variable.kg_cloud_oldx=variable.kg_cloud_x;variable.kg_cloud_y=0;variable.kg_cloud_oldy=variable.kg_cloud_y;variable.kg_cloud_z=0;variable.kg_cloud_oldz=variable.kg_cloud_z;variable.kg_cloud_dx=(0)+math.random(-0.4,0.4);variable.kg_cloud_dy=(0)+math.random(-0.4,0.4);variable.kg_cloud_dz=(0)+math.random(-0.4,0.4);variable.kg_cloud_scale=(math.random(0,1)+math.random(0,1)+1)*0.06/math.max(0.000000000001,math.sqrt(variable.kg_cloud_dx*variable.kg_cloud_dx+variable.kg_cloud_dy*variable.kg_cloud_dy+variable.kg_cloud_dz*variable.kg_cloud_dz));variable.kg_cloud_dx=variable.kg_cloud_dx*(variable.kg_cloud_scale);variable.kg_cloud_dy=variable.kg_cloud_dy*(variable.kg_cloud_scale);variable.kg_cloud_dz=variable.kg_cloud_dz*(variable.kg_cloud_scale);variable.kg_cloud_dy=variable.kg_cloud_dy+(0.1);variable.kg_cloud_dx=variable.kg_cloud_dx*0.1+((variable.kg_velocity_x ?? 0)/20);variable.kg_cloud_dy=variable.kg_cloud_dy*0.1+((variable.kg_velocity_y ?? 0)/20);variable.kg_cloud_dz=variable.kg_cloud_dz*0.1+((variable.kg_velocity_z ?? 0)/20);variable.kg_cloud_gray=1-math.random(0,0.3);"
      }
    }
  }
}
